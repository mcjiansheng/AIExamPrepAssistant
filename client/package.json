{
  "name": "fullgrid-client",
  "private": true,
  "version": "0.1.0",
  "description": "满格 Web 前端：鸿蒙原生版的设计与实现蓝本",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "dev": "node scripts/tokens.mjs && vite",
    "build": "node scripts/tokens.mjs && tsc -p tsconfig.json && vite build",

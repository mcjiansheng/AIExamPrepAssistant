    { "id": "question_d_1", "blueprint_id": "blueprint_d_math", "knowledge_point_id": "kp_d_taylor", "question_type": "calculation", "stem_md": "求 $f(x)=e^x$ 在 $x=0$ 处的二阶泰勒多项式。", "answer_md": "$1+x+\\frac{x^2}{2}$", "explanation_md": "$f(0)=f'(0)=f''(0)=1$，代入泰勒公式即可。", "source_refs": [{ "material_id": "material_d_slides", "page": 12 }], "verification": { "status": "passed", "method": "code_execution" } },
    { "id": "question_c_1", "blueprint_id": "blueprint_c_math", "knowledge_point_id": "kp_c_taylor", "question_type": "calculation", "stem_md": "求 $\\sin x$ 在 $x=0$ 处的三阶麦克劳林多项式。", "answer_md": "$x-\\frac{x^3}{6}$", "explanation_md": "$\\sin x$ 在 $0$ 处的一阶导数为 $1$，二阶导数为 $0$，三阶导数为 $-1$。", "source_refs": [{ "material_id": "material_b_slides", "page": 8 }], "verification": { "status": "passed", "method": "code_execution" } },
    { "id": "question_a_1", "blueprint_id": "blueprint_a_cpp", "knowledge_point_id": "kp_a_cpp_pure_virtual", "question_type": "short_answer", "stem_md": "含有纯虚函数的 C++ 类能否直接实例化？为什么？", "answer_md": "不能。它是抽象类，派生类要实现全部纯虚函数后才能实例化。", "explanation_md": "类中存在未被覆盖的纯虚函数时，该类就是抽象类，只能作为基类使用。", "cross_course_note": { "personal_link_id": "plink_a_interface", "note_md": "可以类比 Java 接口不能直接 new，但 C++ 抽象类可以有数据成员，Java 接口不能有实例字段。" }, "source_refs": [{ "material_id": "material_a_cpp", "page": 31 }], "verification": { "status": "passed", "method": "human_review" } }
